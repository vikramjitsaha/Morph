# ─────────────────────────────────────────────────────────────────
# proto-agent .env configuration
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────────

# ── LLM Provider ─────────────────────────────────────────────────
# Choose: "openrouter" or "ollama"
LLM_PROVIDER=openrouter

# ── OpenRouter (https://openrouter.ai) ───────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Recommended models for code generation:
# anthropic/claude-3.5-haiku          (fast, cheap, great for code)
# anthropic/claude-3.5-sonnet         (best quality, slightly slower)
# openai/gpt-4o-mini                  (fast & cheap)
# openai/gpt-4o                       (best OpenAI model)
# google/gemini-flash-1.5             (very fast)
# deepseek/deepseek-coder-v2          (excellent for code)
# meta-llama/llama-3.1-70b-instruct   (open source, great quality)
OPENROUTER_MODEL=anthropic/claude-3-haiku

# ── Ollama (https://ollama.ai) ────────────────────────────────────
# Run Ollama locally: ollama serve
# Pull a model:       ollama pull codellama:13b
OLLAMA_BASE_URL=http://localhost:11434

# Recommended local models for code generation:
# codellama:13b         (Meta's code-specialised model)
# codellama:34b         (larger, better quality)
# deepseek-coder:6.7b   (excellent code generation)
# deepseek-coder:33b    (best local code model)
# llama3.2:3b           (fast, decent quality)
# llama3.1:8b           (good quality)
# mistral:7b            (fast general purpose)
# qwen2.5-coder:7b      (strong code model)
OLLAMA_MODEL=codellama:13b

# ── Generation Settings ───────────────────────────────────────────
# Max tokens per LLM call (increase for more complete code generation)
MAX_TOKENS=4096

# Temperature: 0.0 = deterministic, 1.0 = creative (0.2-0.4 for code)
TEMPERATURE=0.3

# ── Paths ─────────────────────────────────────────────────────────
# Default requirements file to read
REQUIREMENTS_FILE=./requirements.md

# Where ZIP and workspace are written
OUTPUT_DIR=./output

# ── Dashboard ─────────────────────────────────────────────────────
# Dashboard refresh rate in seconds (0.25 = 4 fps, 0.1 = 10 fps)
DASHBOARD_REFRESH_RATE=0.25
